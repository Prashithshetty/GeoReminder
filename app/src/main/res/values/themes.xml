<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GeoReminder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.GeoReminder.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/alarm_dark</item>
        <item name="android:statusBarColor">@color/alarm_dark</item>
        <item name="android:navigationBarColor">@color/alarm_dark</item>
        <item name="android:showWhenLocked" tools:targetApi="o_mr1">true</item>
        <item name="android:turnScreenOn" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
